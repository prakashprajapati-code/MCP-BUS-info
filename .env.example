# Copy this file to .env and fill in the values.
# .env is gitignored - never commit real credentials or hosts.
# Required keys are blank on purpose: the server refuses to start until they
# are filled in, instead of failing later with a network error.

# ---------------------------------------------------------------- required
# Upstream GSRTC host, e.g. https://<upstream-host>
GSRTC_BASE_URL=
# Device id sent with the session handshake
GSRTC_ANDROID_ID=
GSRTC_USER_AGENT=okhttp/3.4.2

# ---------------------------------------------------------------- optional
# direct (default) calls GSRTC itself; http talks to a local api.js wrapper.
GSRTC_MODE=direct
GSRTC_TIMEOUT_SEC=30
# Timezone used for "today" and "has this time passed". Fixed to IST for GSRTC.
GSRTC_TZ=Asia/Kolkata

# HTTP entry point (server.js)
PORT=3001
HOST=0.0.0.0
MCP_AUTH_TOKEN=

# http mode only
GSRTC_API_TIMEOUT_MS=90000

# Transport binary override
# GSRTC_CURL=curl
